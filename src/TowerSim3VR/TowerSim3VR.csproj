<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TowerSim3VR</AssemblyName>
    <RootNamespace>TowerSim3VR</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Game install location, used only by the deploy step. Override with -p:GameDir=... if it moves. -->
    <GameDir>E:\Programs\Steam\steamapps\common\Tower! Simulator 3</GameDir>
  </PropertyGroup>

  <!-- Filled by scripts/setup-dependencies.ps1 (not in git: the game's and BepInEx's own assemblies) -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>..\..\lib\bepinex\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>..\..\lib\bepinex\0Harmony.dll</HintPath><Private>false</Private></Reference>

    <Reference Include="UnityEngine"><HintPath>..\..\lib\game\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>..\..\lib\game\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>..\..\lib\game\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>..\..\lib\game\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>..\..\lib\game\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>..\..\lib\game\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>..\..\lib\game\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.VideoModule"><HintPath>..\..\lib\game\UnityEngine.VideoModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>..\..\lib\game\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>..\..\lib\game\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime"><HintPath>..\..\lib\game\Unity.RenderPipelines.HighDefinition.Runtime.dll</HintPath><Private>false</Private></Reference>

    <Reference Include="Assembly-CSharp"><HintPath>..\..\lib\game\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- openvr_api.dll ships alongside the plugin DLL so P/Invoke can find it; SteamVR Input files are loaded from there too -->
  <ItemGroup>
    <None Include="..\..\lib\openvr_api.dll"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="Input\*.json"><Link>%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>

  <!-- Deploy straight into the game's BepInEx/plugins folder after each build -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx')">
    <ItemGroup>
      <DeployFiles Include="$(OutDir)TowerSim3VR.dll;$(OutDir)openvr_api.dll;$(OutDir)towersim3vr_*.json" />
    </ItemGroup>
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\TowerSim3VR" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(GameDir)\BepInEx\plugins\TowerSim3VR" />
  </Target>

</Project>
